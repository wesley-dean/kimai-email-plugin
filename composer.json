{
    "name": "wesley-dean/kimai-email-plugin",
    "description": "Send existing Kimai invoices to customers through a secured manual email workflow",
    "homepage": "https://github.com/wesley-dean/kimai-email-plugin",
    "type": "kimai-plugin",
    "version": "0.2.1",
    "license": "MIT",
    "authors": [
        {
            "name": "Wes Dean",
            "homepage": "https://fewerincidents.com"
        }
    ],
    "keywords": [
        "kimai",
        "kimai-plugin",
        "invoice",
        "email"
    ],
    "require": {
        "php": ">=8.2 <8.6"
    },
    "autoload": {
        "psr-4": {
            "KimaiPlugin\\InvoiceEmailerBundle\\": ""
        }
    },
    "extra": {
        "kimai": {
            "require": 26700,
            "name": "Invoice Emailer"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": false,
            "symfony/runtime": false
        },
        "platform": {
            "php": "8.2"
        },
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true
    },
    "autoload-dev": {
        "KimaiPlugin\\InvoiceEmailerBundle\\Tests\\": "tests/"
    },
    "require-dev": {
        "kimai/kimai": "2.67.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5"
    },
    "scripts": {
        "test-unit": "vendor/bin/phpunit --configuration phpunit.xml.dist",
        "phpstan": "vendor/bin/phpstan analyse --configuration phpstan.neon",
        "quality": [
            "composer validate --strict --no-check-version",
            "@phpstan",
            "@test-unit"
        ]
    }
}
